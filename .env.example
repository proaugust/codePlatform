APP_NAME=Code Platform
DEBUG=true
SERVE_STATIC=0

# DeepSeek（OpenAI 兼容）— 请填入你的 Key
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=180

# 5+1 Agent：Planner 后是否自动批准（true 兼容现前端两步流）
AUTO_APPROVE_PLAN=true
# Validator 失败回修次数上限
VALIDATE_MAX_REPAIRS=3

DATABASE_URL=postgresql://postgres:postgres@localhost:5435/ai_test
LLM_MODEL=deepseek-v4-flash
