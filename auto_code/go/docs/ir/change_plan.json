{
  "lang": "go",
  "mode": "incremental",
  "approved": true,
  "summary": "以 main.go + PostgreSQL 为唯一运行入口；统一响应包装；库存只认 {stock}；业务前端为 auto_code/frontend；文档对齐；删除未接线 internal/。",
  "modules": [
    {
      "name": "main",
      "responsibility": "路由、CORS、PG Store、统一 JSON 响应、监听 127.0.0.1:8072"
    },
    {
      "name": "frontend",
      "responsibility": "Vue 列表编辑弹窗、updateBook PUT、updateStock 发 {stock}"
    }
  ],
  "apis": [
    {
      "method": "GET",
      "path": "/health",
      "description": "健康检查，返回 {\"status\":\"ok\"}"
    },
    {
      "method": "GET",
      "path": "/api/books",
      "description": "图书列表，data 为 Book 数组"
    },
    {
      "method": "POST",
      "path": "/api/books",
      "description": "新增图书，201，data 为 Book"
    },
    {
      "method": "GET",
      "path": "/api/books/{id}",
      "description": "按 id 查询"
    },
    {
      "method": "PUT",
      "path": "/api/books/{id}",
      "description": "修改图书，请求体 title/author/stock"
    },
    {
      "method": "DELETE",
      "path": "/api/books/{id}",
      "description": "删除图书，204"
    },
    {
      "method": "PATCH",
      "path": "/api/books/{id}/stock",
      "description": "设置库存，请求体仅 {stock} 绝对值"
    },
    {
      "method": "GET",
      "path": "/",
      "description": "API 占位 JSON；UI 在 Vite 5175"
    }
  ],
  "data_model": [
    {
      "name": "Book (PostgreSQL books)",
      "fields": [
        "id BIGSERIAL PK",
        "title TEXT NOT NULL",
        "author TEXT",
        "stock INT >= 0",
        "created_at / updated_at TIMESTAMPTZ"
      ]
    }
  ],
  "tasks": [
    {
      "id": "T1",
      "title": "main.go 统一响应与 PG 契约",
      "deps": [],
      "files": ["main.go"],
      "acceptance": [
        "成功响应 {code:0,message,data}；失败 {code,message,error}",
        "PATCH stock 只认 {stock}",
        "无对 internal 的依赖"
      ]
    },
    {
      "id": "T2",
      "title": "Vue 库存与编辑对齐",
      "deps": ["T1"],
      "files": [
        "../frontend/src/api/client.ts",
        "../frontend/src/views/BookListView.vue",
        "../frontend/src/views/BookDetailView.vue"
      ],
      "acceptance": [
        "updateStock 发送 {stock}",
        "列表编辑调用 PUT 后刷新"
      ]
    },
    {
      "id": "T3",
      "title": "文档与 spec 对齐 PG",
      "deps": ["T1"],
      "files": [
        "docs/01-requirements.md",
        "docs/02-architecture.md",
        "docs/03-database.md",
        "docs/04-api.md",
        "docs/05-structure.md",
        "docs/06-review.md",
        "docs/ir/spec.json",
        "docs/ir/change_plan.json"
      ],
      "acceptance": [
        "文档写明 PostgreSQL 与 main.go 唯一入口",
        "不再以内存/internal/static 为主路径"
      ]
    }
  ],
  "risks": [
    "运行前需 PostgreSQL 可达，否则进程 Fatal",
    "已有库若含旧 price 列，CREATE IF NOT EXISTS 不会改表结构，需人工迁移时注意",
    "平台 codegen 仍偏好单文件 main.go，增量勿再生成 internal/"
  ]
}
